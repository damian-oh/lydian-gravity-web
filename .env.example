# Base URL of the FastAPI backend, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# Demo mode: auto-provision a throwaway account on load so visitors can explore
# without registering. Requires DEMO_MODE=True on the backend. These are baked
# in at build time, so changing this needs a rebuild.
NEXT_PUBLIC_DEMO_MODE=false
